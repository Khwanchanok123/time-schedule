# ---- รันบนเครื่อง ----
# ไม่ต้องตั้งค่าอะไรเลย: ถ้าไม่มี DATABASE_URL ระบบจะใช้ PGlite (Postgres ในตัว) เก็บข้อมูลไว้ที่ ./.data

# ---- Production (Vercel + Neon) ----
# Connection string จาก Neon (Vercel → Storage → Neon จะตั้งให้อัตโนมัติ)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# คีย์สำหรับลงลายเซ็นคุกกี้ล็อกอิน (สุ่มยาว ๆ เช่น `openssl rand -base64 32`)
# ถ้าไม่ตั้ง จะใช้ DATABASE_URL เป็นคีย์แทน
AUTH_SECRET=
